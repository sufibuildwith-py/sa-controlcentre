# ==============================================================================
# SA COMMAND — PRODUCTION ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env and configure the appropriate values.
# Real credentials and secrets must NEVER be committed to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. REQUIRED PRODUCTION CONFIGURATION
# ------------------------------------------------------------------------------

# Application mode: "production" enforces strict security, origin checks, and
# disables all demo seeders, simulation controllers, and console messaging.
APP_MODE=production

# Database connectivity (PostgreSQL 15+)
DATABASE_URL=jdbc:postgresql://your-postgres-host:5432/sa_command
DATABASE_USERNAME=sa_command_user
DATABASE_PASSWORD=CHANGE_ME_TO_STRONG_PASSWORD

# Allowed CORS origins for browser/desktop web clients.
# Multiple origins may be separated by commas. Must be exact HTTPS or native Tauri origins.
# Example: https://panel.saproduction.in,https://command.saproduction.in
DESKTOP_ORIGINS=https://panel.saproduction.in

# Messaging provider: in production, set to "meta" (for WhatsApp) or "unconfigured"
# Note: "console" messaging is blocked by RuntimeModeValidator when APP_MODE=production.
MESSAGING_PROVIDER=unconfigured

# System timezone for operational records and scheduling
APP_TIME_ZONE=Asia/Kolkata

# ------------------------------------------------------------------------------
# 2. FIRST-RUN OWNER BOOTSTRAP (Required for clean production install)
# ------------------------------------------------------------------------------
# When starting against an empty database, these credentials create the initial
# ROLE_OWNER account with a BCrypt-hashed password. Once created, subsequent
# application startups ignore these variables.
BOOTSTRAP_OWNER_EMAIL=owner@saproduction.in
BOOTSTRAP_OWNER_PASSWORD=CHANGE_ME_MIN_12_CHARS
BOOTSTRAP_OWNER_NAME=Azeem Khan

# ------------------------------------------------------------------------------
# 3. FINANCE PRIVACY VEIL CONFIGURATION (Required in Production)
# ------------------------------------------------------------------------------
# SHA-256 hash of the owner's confidential 6-digit finance unlock PIN.
# In production, this variable is REQUIRED. Application startup will fail if left
# unset, malformed, or equal to the insecure demo default hash.
# To generate a custom hash, run in your terminal:
#   echo -n "YOUR_6_DIGIT_PIN" | sha256sum
FINANCE_UNLOCK_CODE_HASH=YOUR_CUSTOM_SHA256_HEX_HASH

# Duration of the owner's unlocked finance session grant in minutes (default: 30)
FINANCE_ACCESS_TTL_MINUTES=30

# ------------------------------------------------------------------------------
# 4. FRONTEND BUILD CONFIGURATION (Vite)
# ------------------------------------------------------------------------------
# Public API base URL accessed by the browser/web client
VITE_API_URL=https://panel.saproduction.in/api/v1

# Frontend operational mode: "production" enables clean login forms without demo autofill
VITE_APP_MODE=production

# Set to "web" for standard web browser hosting (e.g., Vercel, static host, nginx)
VITE_BUILD_TARGET=web

# ------------------------------------------------------------------------------
# 5. OPTIONAL SERVICES & INTEGRATIONS
# ------------------------------------------------------------------------------

# WhatsApp Cloud API (Required if MESSAGING_PROVIDER=meta)
META_WHATSAPP_API_VERSION=v23.0
META_WHATSAPP_PHONE_NUMBER_ID=
META_WHATSAPP_ACCESS_TOKEN=
META_WHATSAPP_APP_SECRET=
META_WHATSAPP_VERIFY_TOKEN=

# EVE Cognitive Intelligence Engine
# Options:
# - TEST: Safe deterministic degraded/test mode only. NOT real AI inference.
# - LOCAL_QWEN_THINKING: Real AI provider connecting to an external OpenAI/llama.cpp-compatible server.
EVE_MODEL_PROVIDER=TEST
# When using a real AI provider with an external OpenAI/llama.cpp-compatible server:
# EVE_LOCAL_MODEL_URL=https://ai-runtime.internal:8090

# Navigator Microservice (disabled by default in production)
NAVIGATOR_ENABLED=false
NAVIGATOR_GATEWAY_URL=http://navigator-gateway:8091
NAVIGATOR_ORGANIZATION_PUBLIC_ID=
NAVIGATOR_SERVICE_KEY=
NAVIGATOR_SIMULATOR_ENABLED=false
VITE_NAVIGATOR_ENABLED=false

# ------------------------------------------------------------------------------
# 6. DEVELOPMENT-ONLY (Never use in production)
# ------------------------------------------------------------------------------
# DEMO_SEED=false
# NAVIGATOR_SIMULATOR_ENABLED=false
