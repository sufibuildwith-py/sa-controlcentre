APP_MODE=demo
DEMO_SEED=true
VITE_APP_MODE=demo
VITE_API_URL=http://localhost:8080/api/v1
MESSAGING_PROVIDER=console
MESSAGING_WORKER_ENABLED=true
MESSAGING_MAX_ATTEMPTS=4
# Production WhatsApp Cloud API settings (backend only; never expose through Vite)
META_WHATSAPP_API_VERSION=v23.0
META_WHATSAPP_PHONE_NUMBER_ID=
META_WHATSAPP_ACCESS_TOKEN=
META_WHATSAPP_APP_SECRET=
META_WHATSAPP_VERIFY_TOKEN=
# Navigator is demo-only. Keep both flags false for production release builds.
NAVIGATOR_ENABLED=false
NAVIGATOR_GATEWAY_URL=http://127.0.0.1:8091
NAVIGATOR_ORGANIZATION_PUBLIC_ID=6be51f4b-e5bd-4e91-8d60-4e41a72ad86f
NAVIGATOR_SERVICE_KEY=
NAVIGATOR_SIMULATOR_ENABLED=false
VITE_NAVIGATOR_ENABLED=false
